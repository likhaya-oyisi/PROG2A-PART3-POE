<Window x:Class="CybersecurityChatbot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="780" Width="1180"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  SIDEBAR  -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BgCard}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ASCII Logo -->
                <Border Grid.Row="0" Padding="20,24,20,0">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource AccentCyan}" LineHeight="13"
                                   Text="  ██████╗██╗   ██╗██████╗ &#x0a;██╔════╝╚██╗ ██╔╝██╔══██╗&#x0a;██║      ╚████╔╝ ██████╔╝ &#x0a;██║       ╚██╔╝  ██╔══██╗ &#x0a;╚██████╗   ██║   ██████╔╝ &#x0a; ╚═════╝   ╚═╝   ╚═════╝  "/>
                        <TextBlock FontFamily="Consolas" FontSize="9"
                                   Foreground="{StaticResource AccentGreen}" Margin="0,2,0,0"
                                   Text="██████╗  ██████╗ ████████╗&#x0a;██╔══██╗██╔═══██╗╚══██╔══╝&#x0a;██████╔╝██║   ██║   ██║   &#x0a;██╔══██╗██║   ██║   ██║   &#x0a;██████╔╝╚██████╔╝   ██║   &#x0a;╚═════╝  ╚═════╝    ╚═╝   "/>
                    </StackPanel>
                </Border>

                <!-- Tagline -->
                <Border Grid.Row="1" Padding="20,12,20,0">
                    <StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,0,0,12"/>
                        <TextBlock Text="CYBERSECURITY AWARENESS"
                                   Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Text="Your digital safety guide"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Sidebar scroll -->
                <ScrollViewer Grid.Row="2" Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,0">

                        <!-- Session card -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SESSION" Foreground="{StaticResource TextMuted}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SidebarUserName" Foreground="{StaticResource TextPrimary}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SidebarMessageCount" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory panel -->
                        <Border x:Name="MemoryPanel" Background="{StaticResource BgCard}" CornerRadius="8"
                                Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Foreground="{StaticResource AccentYellow}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MemoryTopicLabel" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Sentiment panel -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MOOD DETECTED" Foreground="{StaticResource TextMuted}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SentimentLabel" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" Margin="0,6,0,0" Text="Neutral"/>
                            </StackPanel>
                        </Border>

                        <!-- Database status -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DATABASE" Foreground="{StaticResource TextMuted}"
                                           FontSize="9" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="DbStatusDot" Width="8" Height="8"
                                             Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="DbStatusLabel" Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" Text="Initialising..." TextWrapping="Wrap"
                                               MaxWidth="200"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick topics -->
                        <TextBlock Text="QUICK TOPICS" Foreground="{StaticResource TextMuted}"
                                   FontSize="9" FontWeight="SemiBold" Margin="0,4,0,8"/>

                        <Button Content="Phishing Tips" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="Give me a phishing tip"/>
                        <Button Content="Password Safety" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="Tell me about password safety"/>
                        <Button Content="Safe Browsing" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="How do I browse safely"/>
                        <Button Content="Malware" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="What is malware"/>
                        <Button Content="Two-Factor Auth" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="Explain two-factor authentication"/>
                        <Button Content="Privacy &amp; POPIA" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="Tell me about privacy and POPIA"/>
                        <Button Content="Social Engineering" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="What is social engineering"/>
                        <Button Content="VPNs" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="What is a VPN"/>

                        <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,12,0,12"/>

                        <!-- Part 3 quick actions -->
                        <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource TextMuted}"
                                   FontSize="9" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <Button Content="Add a task" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="Add task - Review privacy settings"/>
                        <Button Content="Start the quiz" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="start quiz"/>
                        <Button Content="Show activity log" Style="{StaticResource ChipBtn}"
                                HorizontalAlignment="Left" Click="QuickTopic_Click" Tag="show activity log"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="3" Padding="16,12"
                        BorderBrush="{StaticResource BgCard}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Stay vigilant. Stay secure."
                               Foreground="{StaticResource TextMuted}" FontSize="10"
                               FontStyle="Italic" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!--  MAIN AREA  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar with tab navigation -->
            <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BgCard}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="TabChat"     Content="Chat"          Style="{StaticResource TabBtnActive}" Click="TabChat_Click"/>
                        <Button x:Name="TabTasks"    Content="Tasks"         Style="{StaticResource TabBtn}"       Click="TabTasks_Click"/>
                        <Button x:Name="TabQuiz"     Content="Quiz"          Style="{StaticResource TabBtn}"       Click="TabQuiz_Click"/>
                        <Button x:Name="TabLog"     Content="Activity Log"  Style="{StaticResource TabBtn}"       Click="TabLog_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0"/>
                        <TextBlock Text="CyberBot is online" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  View 1: CHAT  -->
            <Grid x:Name="ChatView" Grid.Row="1" Visibility="Visible">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,8,6,8">
                    <StackPanel x:Name="ChatPanel" Margin="24,8"/>
                </ScrollViewer>
            </Grid>

            <!--  View 2: TASKS  -->
            <Grid x:Name="TasksView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24,20,24,12">
                    <StackPanel>
                        <TextBlock Text="Cybersecurity Tasks" Foreground="{StaticResource TextPrimary}"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Manage your cybersecurity to-do list and reminders"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
                    <StackPanel>

                        <!-- Add task form -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="10"
                                Padding="20" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Add a new task" Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="Title" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TaskTitleInput" Style="{StaticResource ChatInput}"
                                         Height="40" Margin="0,0,0,10"/>

                                <TextBlock Text="Description" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TaskDescriptionInput" Style="{StaticResource ChatInput}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="14,8" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Reminder (optional)" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <DatePicker x:Name="TaskReminderPicker" FontSize="13"
                                                    Background="{StaticResource BgInput}"
                                                    Foreground="{StaticResource TextPrimary}"
                                                    BorderBrush="{StaticResource BorderSubtle}"
                                                    Padding="10,8"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Add Task" Style="{StaticResource SendBtn}"
                                            Height="38" Width="120" VerticalAlignment="Bottom"
                                            Click="AddTaskButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Task list -->
                        <TextBlock Text="Your tasks" Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel x:Name="TaskListPanel"/>

                        <TextBlock x:Name="EmptyTasksLabel" Text="No tasks yet. Add one above or ask CyberBot to add one for you!"
                                   Foreground="{StaticResource TextMuted}" FontSize="13" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,24,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  View 3: QUIZ  -->
            <Grid x:Name="QuizView" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
                    <StackPanel>

                        <!-- Quiz header -->
                        <TextBlock Text="Cybersecurity Quiz" Foreground="{StaticResource TextPrimary}"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Test your cybersecurity knowledge"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,16"/>

                        <!-- Quiz intro state -->
                        <StackPanel x:Name="QuizIntroPanel">
                            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="24"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Ready to test your knowledge?"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="This quiz has 13 questions covering phishing, passwords, malware, social engineering, and more. You'll get immediate feedback after each answer."
                                               Foreground="{StaticResource TextSecondary}" FontSize="13"
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Button Content="Start Quiz" Style="{StaticResource SendBtn}"
                                            Height="42" Width="160" HorizontalAlignment="Left"
                                            Click="StartQuizButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Quiz question state -->
                        <StackPanel x:Name="QuizQuestionPanel" Visibility="Collapsed">
                            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="24"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <TextBlock x:Name="QuizProgressLabel" Foreground="{StaticResource AccentOrange}"
                                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="QuizScoreLabel" Foreground="{StaticResource AccentGreen}"
                                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock x:Name="QuizQuestionText" Foreground="{StaticResource TextPrimary}"
                                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Margin="0,0,0,20" LineHeight="24"/>

                                    <StackPanel x:Name="QuizOptionsPanel"/>

                                    <!-- Feedback section -->
                                    <Border x:Name="QuizFeedbackPanel" Margin="0,12,0,0" Padding="14,10"
                                            CornerRadius="8" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="QuizFeedbackResult" FontSize="13" FontWeight="SemiBold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Name="QuizFeedbackExplanation" Foreground="{StaticResource TextPrimary}"
                                                       FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                                            <Button x:Name="QuizNextButton" Content="Next Question →"
                                                    Style="{StaticResource SendBtn}" Height="38" Width="160"
                                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                                    Click="QuizNextButton_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Quiz result state -->
                        <StackPanel x:Name="QuizResultPanel" Visibility="Collapsed">
                            <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="24"
                                    BorderBrush="{StaticResource AccentGreen}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Quiz Complete!" Foreground="{StaticResource AccentGreen}"
                                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="QuizFinalScoreText" Foreground="{StaticResource TextPrimary}"
                                               FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="22"/>
                                    <Button Content="Play Again" Style="{StaticResource SendBtn}"
                                            Height="42" Width="160" HorizontalAlignment="Left"
                                            Click="StartQuizButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  View 4: ACTIVITY LOG  -->
            <Grid x:Name="LogView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24,20,24,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource TextPrimary}"
                                       FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LogSubtitleLabel" Text="Showing the last 5 actions"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="LogShowMoreButton" Content="Show full log"
                                Style="{StaticResource ChipBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="LogShowMoreButton_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
                    <StackPanel x:Name="LogPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- Suggestion chips -->
            <Border Grid.Row="2" Padding="24,8,24,4">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Give me another tip" Style="{StaticResource ChipBtn}"
                            Click="QuickTopic_Click" Tag="Give me another tip"/>
                    <Button Content="What have you done for me?" Style="{StaticResource ChipBtn}"
                            Click="QuickTopic_Click" Tag="show activity log"/>
                    <Button Content="help" Style="{StaticResource ChipBtn}"
                            Click="QuickTopic_Click" Tag="help"/>
                </WrapPanel>
            </Border>

            <!-- Input row -->
            <Border Grid.Row="3" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BgCard}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource ChatInput}"
                             Height="46" KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>

                    <TextBlock x:Name="InputPlaceholder" Grid.Column="0"
                               Text="Type your name to get started..." Foreground="{StaticResource TextMuted}"
                               FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="14,0,0,0"/>

                    <Button x:Name="SendButton" Grid.Column="2" Content="Send"
                            Style="{StaticResource SendBtn}" Height="46" Click="SendButton_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
